{
  "rewrites": [
    {
      "source": "/ai-tools",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-video-scripts",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-banner-scripts",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-30-days-content",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-daily-article",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-daily-h1-analysis",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/ai-indicator-prompts",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/downloads",
      "destination": "/learning-hub.html"
    },
    {
      "source": "/webinar-admin",
      "destination": "/webinar-admin.html"
    },
    {
      "source": "/expo",
      "destination": "/expo/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
